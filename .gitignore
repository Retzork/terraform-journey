# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan

# Ansible rendered inventory (contains passwords)
ansible/inventory/hosts.yml

# ignore deprecated project das sad asda
06\ Whole\ Dynamics\ GP\ Environment/
*.zip
*.txt